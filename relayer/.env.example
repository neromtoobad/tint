# Tint relayer. Copy to .env and fill in; never commit .env.
# A funded key that only pays gas. It never holds user funds for long:
# fees arrive in USDG or stock tokens and can be swept to the treasury.
RELAYER_KEY=
# Either point at a deployments JSON (pool, chainId, rpc)...
DEPLOYMENT=../contracts/deployments/46630.json
# ...or set these directly
# RPC_URL=https://rpc.testnet.chain.robinhood.com
# POOL=0x...
# CHAIN_ID=46630
# The cash token fees are priced in, and the Uniswap QuoterV2 used to price stock fees
# CASH_TOKEN=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168
# CASH_DECIMALS=6
# QUOTER=0x33e885eD0Ec9bF04EcfB19341582aADCb4c8A9E7
# Fee per relayed transaction, in dollars
FEE_USD=0.50
PORT=8790
# Lock this to the wallet's origin in production
ALLOW_ORIGIN=*
