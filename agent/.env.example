# Tint agent runner. Copy to .env and fill in; never commit .env.
# The agent key from the wallet's Agents panel (tintagent1…). It can trade
# inside the account within its rules. It can't move money out.
AGENT_KEY=
# Either a deployments JSON (pool, chainId, rpc, startBlock)...
DEPLOYMENT=../contracts/deployments/46630.json
# ...or these
# RPC_URL=https://rpc.testnet.chain.robinhood.com
# POOL=0x...
# CHAIN_ID=46630
# START_BLOCK=0
RELAYER_URL=http://127.0.0.1:8790
# Uniswap QuoterV2, to price each buy
# QUOTER=0x33e885eD0Ec9bF04EcfB19341582aADCb4c8A9E7
# Seconds between checks for a due round
CHECK_EVERY=60
# Set to 1 to run one check and exit
# ONCE=1
